# Dev: /api so'rovlari shu PHP backendga proxy qilinadi
VITE_API_PROXY_TARGET=http://localhost

# --- Vercel → Settings → Environment Variables (VITE_ prefiksisiz, server uchun) ---
# BACKEND_ORIGIN=https://backend-domeningiz.uz       (PHP backend manzili)
# PROXY_SHARED_SECRET=...                            (backend .env dagi bilan bir xil, ixtiyoriy)

# Chatdagi rasmlar uchun PHP backend manzili (brauzerda to'g'ridan-to'g'ri ochiladi)
VITE_BACKEND_URL=https://backend-domeningiz.uz
